{
  "name": "nextgen-camera-3d-cad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "pp": "./scripts/pp.mjs",
    "bg": "./scripts/bg.mjs",
    "sp": "./scripts/sp.mjs",
    "dx": "./scripts/dx.mjs",
    "sokutei": "./scripts/sokutei.mjs",
    "exam": "./scripts/exam.mjs",
    "tlx": "./scripts/exam.mjs",
    "sim20": "./scripts/exam.mjs"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "catalog": "node scripts/generate_catalogs.mjs",
    "mirai:content": "node scripts/build_mirai_content.mjs",
    "bg": "node scripts/bg.mjs",
    "sp": "node scripts/sp.mjs",
    "dx": "node scripts/dx.mjs",
    "pp": "node scripts/pp.mjs",
    "capture": "node scripts/pp.mjs",
    "sokutei": "node scripts/sokutei.mjs",
    "exam": "node scripts/exam.mjs",
    "tlx": "node scripts/exam.mjs",
    "sim20": "node scripts/exam.mjs",
    "validate": "node scripts/validate_parts.mjs",
    "verify:wlk220": "node scripts/verify_wlk220_industrial.mjs",
    "build": "tsc --noEmit && vite build && rm -rf docs && cp -r dist docs && touch docs/.nojekyll",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
